sub.TextTransparency = 0.4
sub.Text = "select a script to load"
sub.TextColor3 = Color3.fromRGB(170, 190, 175)
sub.Parent = card

local y = 78
for _, s in ipairs(SCRIPTS) do
	local myUrl, myName = s.url, s.name
	local b = Instance.new("TextButton")
	b.Position = UDim2.new(0, 24, 0, y)
	b.Size = UDim2.new(1, -48, 0, 46)
	b.BackgroundColor3 = Color3.fromRGB(30, 36, 30)
	b.Font = Enum.Font.GothamSemibold
	b.TextSize = 14
	b.TextXAlignment = Enum.TextXAlignment.Left
	b.Text = "   ▶   " .. myName
	b.TextColor3 = Color3.fromRGB(255, 255, 255)
	b.AutoButtonColor = false
	b.Parent = card
	local bc = Instance.new("UICorner")
	bc.CornerRadius = UDim.new(0, 12)
	bc.Parent = b
	local bar = Instance.new("Frame")
	bar.Size = UDim2.new(0, 0, 0, 3)
	bar.Position = UDim2.new(0, 0, 1, -3)
	bar.BackgroundColor3 = ACC
	bar.BorderSizePixel = 0
	bar.Parent = b
	local bcc = Instance.new("UICorner")
	bcc.CornerRadius = UDim.new(0, 2)
	bcc.Parent = bar
	b.MouseButton1Click:Connect(function()
		b.Text = "   ▶   " .. myName .. "   ·   loading..."
		TS:Create(bar, TweenInfo.new(0.6, Enum.EasingStyle.Linear), { Size = UDim2.new(1, 0, 0, 3) }):Play()
		task.wait(0.65)
		gg:Destroy()
		local ok, err = pcall(function()
			loadstring(game:HttpGet(myUrl))()
		end)
		if not ok then
			warn("[ambient loader] " .. myName .. " failed: " .. tostring(err))
		end
	end)
	y += 54
end

