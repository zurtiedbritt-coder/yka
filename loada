local SCRIPTS = {
	{
		name = "os.cc",
		url = "https://raw.githubusercontent.com/zurtiedbritt-coder/os.cc/refs/heads/main/os.cc",
	},
	{
		name = "mm2 script",
		url = "https://raw.githubusercontent.com/zurtiedbritt-coder/mm2/refs/heads/main/mm2%20script",
	},
	{
		name = "ambient.cc",
		url = "https://raw.githubusercontent.com/zurtiedbritt-coder/AMBIENT.CC-SOURCE-LOL/refs/heads/main/ambcc",
	},
}

